rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    match /companies/{companyId} {
      allow read: if true;
      allow write: if isValidId(companyId);
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if isValidId(userId);
    }

    match /departments/{departmentId} {
      allow read: if true;
      allow write: if isValidId(departmentId);
    }

    match /statuses/{statusId} {
      allow read: if true;
      allow write: if isValidId(statusId);
    }

    match /workOrders/{workOrderId} {
      allow read: if true;
      allow write: if isValidId(workOrderId);
    }

    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if isValidId(notificationId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
